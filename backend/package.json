{
  "name": "voting-app-backend",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "dev": "tsx watch src/server.ts",
    "dev:legacy": "nodemon index.js",
    "dev:worker": "wrangler dev --config wrangler.toml",
    "types:worker": "wrangler types src/worker-configuration.d.ts --config wrangler.toml",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/db/scripts/migrate.ts",
    "db:seed": "tsx src/db/scripts/seed.ts",
    "db:reset": "tsx src/db/scripts/reset.ts",
    "password:benchmark": "tsx scripts/benchmark-password.ts",
    "format": "prettier --write \"**/*.{ts,tsx}\" \"*.{json,jsonc,mjs}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "multer-storage-cloudinary": "^4.0.0",
    "pg": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  }
}
