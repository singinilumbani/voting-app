{
  "name": "voting-app-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"scripts/**/*.mjs\" \"*.{mjs,ts,json}\" docs/README.md docs/DEVELOPMENT.md docs/screens.md \"docs/implementation-log/*.md\"",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "preinstall": "node scripts/require-pnpm.mjs"
  },
  "dependencies": {
    "@material-symbols/font-400": "^0.48.3",
    "@tanstack/react-query": "^5.107.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "msw": "^3.0.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  },
  "packageManager": "pnpm@12.4.1",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
